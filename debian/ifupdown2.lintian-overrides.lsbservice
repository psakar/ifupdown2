# Only installed by the pkg.ifupdown2.lsbservice build (see debian/rules), which is
# meant for systemd-free derivatives like Devuan: there's intentionally no
# systemd unit for the init script, systemd users get the default build.
ifupdown2: missing-systemd-service-for-init.d-rcS-script
ifupdown2: missing-systemd-service-for-init.d-script
